# Database Configuration (SQLite default for local development)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Authentication (32+ character random string)
JWT_SECRET=f4d3b8e0a6c2d1e8f7a9b3c5d6e7f8a9b3c5d6e7f8a9b3c5d6e7f8a9b3c5d6e7

# Python Proposal Generator Microservice
PYTHON_MICROSERVICE_URL="http://127.0.0.1:5001"

# AWS S3 Storage Configuration (Optional for basic local dev, required for proposal docs & file uploads)
AWS_S3_BUCKET_NAME="your-s3-bucket-name"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="ap-south-1"

# Firebase Cloud Messaging (FCM) Configuration (Optional for web-only dev, required for mobile dialer push notifications)
FCM_CLIENT_EMAIL="your-firebase-admin-email@iam.gserviceaccount.com"
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FCM_PROJECT_ID="your-firebase-project-id"

# Database Email Backup Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
BACKUP_EMAIL_TO=admin@example.com
CRON_SECRET=generate-a-secure-random-string
TZ=Asia/Kolkata
